# Default model to use (must exist in providers.json).
# NVIDIA NIM examples: "openai/gpt-oss-20b" (fast, the default),
#                      "nvidia/nemotron-3-super-120b-a12b" (slower, stronger)
# Ollama examples:     "gemma4:latest", "qwen3:4b", "mistral:7b"
DEFAULT_MODEL=openai/gpt-oss-20b

# API keys — only needed for providers whose api_key_env is set in providers.json.
# The default model runs on NVIDIA NIM, so NVIDIA_API_KEY is the one you need.
NVIDIA_API_KEY=your_nvidia_nim_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB connection string. Optional — omit and evaluations simply are not persisted.
# MONGODB_URI=
